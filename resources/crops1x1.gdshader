shader_type canvas_item;

// ============================================================
// 作物 1×1 通用着色器 — crops1x1
//
// 用于 8×16 格农作物 Sprite2D 的 ShaderMaterial。
// 所有参数均为 @export（在编辑器中可见），可在材质面板或代码中实时修改。
//
// 特性：
//   - 像素完美渲染（filter_nearest）
//   - 不受光照影响（canvas_item 默认无光照）
//   - 保留纹理原始透明像素
//   - 支持可选的自定义纹理覆盖
// ============================================================

// ============================================================
// @export 参数 — 纹理
// ============================================================

// 自定义纹理（勾选 use_custom_tex 后生效）。
// 不设置时使用 Sprite2D 节点自带的纹理。
uniform sampler2D custom_texture : filter_nearest, source_color;

// 是否使用 custom_texture 替代节点默认纹理。
uniform bool use_custom_tex = false;

// ============================================================
// @export 参数 — 变换
// ============================================================

// 纹理像素偏移量（单位：px）。
// 正值向右/下偏移。可用于微调位置或逐帧切换显示区域。
uniform vec2 offset_px = vec2(0.0, 0.0);

// 纹理的实际像素尺寸（宽, 高），用于将 offset_px 从 px 转为 UV。
// 例如：32×16 的 sprite sheet 填 (32, 16)；单帧 8×16 填 (8, 16)。
uniform vec2 texture_size = vec2(32.0, 16.0);

// UV 缩放倍率。
// 1.0 = 原始大小；>1.0 = 放大（zoom in）；<1.0 = 缩小（zoom out）。
// 缩放以纹理中心为基准点。
uniform float scale_mult : hint_range(0.1, 10.0, 0.1) = 1.0;

// ============================================================
// @export 参数 — 颜色
// ============================================================

// 颜色与透明度调制（乘法叠加）。
// RGB 通道调制颜色，A 通道调制透明度。
// 默认值 (1, 1, 1, 1) 表示不改变原始纹理。
// 示例：
//   (1, 0, 0, 1)   → 纯红色调
//   (1, 1, 1, 0.5) → 半透明
//   (0, 0, 0, 1)   → 全黑
uniform vec4 modulate_color : source_color = vec4(1.0, 1.0, 1.0, 1.0);

// ============================================================
// 顶点处理
// ============================================================

void vertex() {
	// 暂无自定义顶点变换
}

// ============================================================
// 辅助函数（必须在 fragment() 之前定义，GLSL 不允许前向引用）
// ============================================================

// 对 UV 坐标应用缩放和像素偏移。
// 缩放以 UV 中心 (0.5, 0.5) 为基准。
// offset_px 通过 texture_size 转换为 UV 单位。
vec2 _apply_transform(vec2 uv) {
	// 居中缩放：先将 UV 原点移到中心，缩放后再移回
	uv = (uv - 0.5) / scale_mult + 0.5;
	// 像素偏移 → UV 偏移（除以纹理像素尺寸）
	uv += offset_px / texture_size;
	return uv;
}

// ============================================================
// 片段处理
// ============================================================

void fragment() {
	// 1. 选择纹理源并计算 UV
	vec4 color;
	if (use_custom_tex) {
		vec2 uv = _apply_transform(UV);
		color = texture(custom_texture, uv);
	} else {
		vec2 uv = _apply_transform(UV);
		color = texture(TEXTURE, uv);
	}

	// 2. 颜色调制（RGB 和 Alpha 均叠加）
	color *= modulate_color;

	// 3. 输出最终颜色（保留纹理原始透明区域）
	COLOR = color;
}
